[Unit]
Description=Garuda camera + Hailo detector for the booth drone (AR0234 on CSI, :8098)
After=network-online.target
Wants=network-online.target

[Service]
User=garuda
WorkingDirectory=/home/garuda/garuda-sdk-deploy
EnvironmentFile=/home/garuda/booth/garuda-mono.env
ExecStart=/usr/bin/python3 -u /home/garuda/garuda-sdk-deploy/hosts/pi5/garuda_mono.py
StandardOutput=append:/home/garuda/mono.log
StandardError=append:/home/garuda/mono.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
